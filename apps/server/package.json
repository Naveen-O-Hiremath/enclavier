{
  "name": "@enclavier/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "audit:verify": "tsx --env-file-if-exists=.env src/cli/verify-audit.ts",
    "mail:test": "tsx --env-file-if-exists=.env src/cli/test-mail.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@enclavier/crypto": "*",
    "@enclavier/shared": "*",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@node-saml/node-saml": "^5.1.0",
    "@simplewebauthn/server": "^13.3.3",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "nodemailer": "^10.0.14",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "xml-crypto": "^6.3.2"
  }
}
