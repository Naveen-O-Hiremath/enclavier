# Copy to .env for local development.
DATABASE_URL=postgres://enclavier:enclavier@localhost:5432/enclavier
# 32+ random characters each. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me
SERVER_SECRET=change-me-too-change-me-too-change-me-too
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
SIGNUPS_ENABLED=true
# Set when running behind a reverse proxy (nginx, load balancer).
TRUST_PROXY=false
# Public URL of the web vault (used in invitation e-mails).
PUBLIC_URL=http://localhost:5173
# Outgoing e-mail. Leave SMTP_HOST empty to log e-mails to the console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Enclavier <no-reply@example.com>
