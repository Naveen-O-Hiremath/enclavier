# Tip: ./install.sh (or .\install.ps1) creates this file for you with fresh secrets.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   (or: openssl rand -base64 48)
POSTGRES_PASSWORD=
JWT_SECRET=
SERVER_SECRET=

# Built-in HTTPS: set your domain and uncomment the next three lines.
# ENCLAVIER_DOMAIN=vault.example.com
# COMPOSE_PROFILES=tls
# ENCLAVIER_BIND=127.0.0.1

# Running from a source checkout: build the images locally.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# Host port for the web vault + API.
ENCLAVIER_PORT=8080
# Public address of the web vault, used in invitation links (e.g. https://vault.example.com).
PUBLIC_URL=http://localhost:8080
# Set to false to allow only invited users to register.
SIGNUPS_ENABLED=true
LOG_LEVEL=info

# ---- Outgoing e-mail (invitations) ------------------------------------------
# Leave SMTP_HOST empty to write e-mails to the server log instead (air-gapped).
# Common settings:
#   GoDaddy / secureserver.net  smtpout.secureserver.net  465  SMTP_SECURE=true
#   Microsoft 365               smtp.office365.com        587  SMTP_SECURE=false
#   Google Workspace            smtp.gmail.com            465  SMTP_SECURE=true (app password)
#   SendGrid                    smtp.sendgrid.net         587  SMTP_SECURE=false (user "apikey")
#   Amazon SES                  email-smtp.<region>.amazonaws.com  587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Enclavier <no-reply@example.com>

# ---- Single sign-on -----------------------------------------------------------
# Allow OpenID Connect providers on private networks (self-hosted Keycloak, ADFS…).
# Keep false for SaaS. SAML needs no outbound calls.
ALLOW_PRIVATE_SSO_ENDPOINTS=false

# ---- Monitoring ---------------------------------------------------------------
# Allow log streaming to private/internal addresses (on-prem SIEM). Keep false for SaaS.
ALLOW_PRIVATE_LOG_DESTINATIONS=false
# Breach checks (k-anonymity). Point at an offline mirror for air-gapped installs, or leave empty to disable.
HIBP_API_URL=https://api.pwnedpasswords.com
# Optional paid HIBP key: lets users check their own e-mail against known breaches.
HIBP_API_KEY=
